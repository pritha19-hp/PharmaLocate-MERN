# MongoDB Atlas Connection String (for Vercel Cloud & Production)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/pharma_locate?retryWrites=true&w=majority

# Local Development Fallback (when running MongoDB locally)
# MONGO_URI=mongodb://127.0.0.1:27017/pharma_locate

PORT=5000
NODE_ENV=development
